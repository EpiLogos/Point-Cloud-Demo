{
  "name": "oi-native-field-studies",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:journeys && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p field-studies-journeys/tsconfig.json",
    "test": "tsx tests/run.ts",
    "predev": "npm run build:journeys",
    "build:journeys": "node field-studies-journeys/scripts/build.mjs",
    "test:journeys": "node --test field-studies-journeys/tests/model.test.mjs",
    "test:gpu": "python field-studies-journeys/tests/native_gpu.py",
    "test:browser": "python field-studies-journeys/tests/native_browser.py",
    "test:workspace": "python field-studies-journeys/tests/workspace_browser.py",
    "test:parity": "tsx tests/parity/independent.ts && tsx tests/parity/inventory.ts && node tests/parity/build.mjs",
    "test:parity:browser": "python field-studies-journeys/tests/parity_gpu.py && python field-studies-journeys/tests/parity_browser.py && python field-studies-journeys/tests/parity_lifecycle.py",
    "test:reference-apps": "node tests/parity/reference-apps.mjs && python field-studies-journeys/tests/reference_apps.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "tweakpane": "^4.0.5",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
