# Neither the native Expressions app (/) nor the retained legacy workbench
# (/legacy.html) requires any environment secret. The AI Studio scaffold
# variables below are unused by both apps; they remain only for that
# retired hosting path.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the hosted URL of that retired applet deployment.
APP_URL="MY_APP_URL"
